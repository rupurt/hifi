{
  "name": "@hifi/core",
  "version": "0.1.0",
  "description": "Shared primitives for programmable hifi design grammars.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spoke-sh/hifi.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/spoke-sh/hifi#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../tooling/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
